<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Soenneker.GraphQL.Generator.Cli</RootNamespace>
        <AssemblyName>gql2cs</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.GraphQL.Generator\Soenneker.GraphQL.Generator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
</Project>
